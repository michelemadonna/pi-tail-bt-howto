#!/bin/bash
set -euo pipefail

G=/sys/kernel/config/usb_gadget/g1

HOST_MAC="3a:ea:66:54:bc:a1"
DEV_MAC="3a:ea:66:54:bc:a2"

modprobe libcomposite

# configfs normalmente è già montato da systemd
if ! mountpoint -q /sys/kernel/config; then
    mount -t configfs none /sys/kernel/config
fi

# Elimina un'eventuale configurazione precedente
if [[ -d "$G" ]]; then
    if [[ -e "$G/UDC" ]]; then
        echo "" > "$G/UDC" || true
    fi

    find "$G/configs" -type l -delete 2>/dev/null || true
    rm -rf "$G/configs/"* 2>/dev/null || true
    rm -rf "$G/functions/"* 2>/dev/null || true
    rm -rf "$G/strings/"* 2>/dev/null || true
    rmdir "$G" 2>/dev/null || true
fi

mkdir -p "$G"
cd "$G"

# Linux Foundation VID/PID comunemente usati per gadget di test.
# Per uso personale va bene; per un prodotto andrebbe usato un VID/PID proprio.
echo 0x1d6b > idVendor
echo 0x0104 > idProduct
echo 0x0100 > bcdDevice
echo 0x0200 > bcdUSB

mkdir -p strings/0x409

echo "00000001" > strings/0x409/serialnumber
echo "Kali Linux" > strings/0x409/manufacturer
echo "Pi Zero 2 W USB Ethernet" > strings/0x409/product

mkdir -p configs/c.1/strings/0x409
echo "CDC ECM" > configs/c.1/strings/0x409/configuration

# 250 mA
echo 125 > configs/c.1/MaxPower

# -------------------------
# CDC ECM Ethernet
# -------------------------

mkdir -p functions/ecm.usb0

echo "$HOST_MAC" > functions/ecm.usb0/host_addr
echo "$DEV_MAC"  > functions/ecm.usb0/dev_addr

ln -s functions/ecm.usb0 configs/c.1/ecm.usb0

# -------------------------
# Bind al controller USB
# -------------------------

UDC="$(ls /sys/class/udc | head -n1)"

if [[ -z "$UDC" ]]; then
    echo "No UDC available" >&2
    exit 1
fi

echo "$UDC" > UDC

echo "USB gadget enabled on $UDC"